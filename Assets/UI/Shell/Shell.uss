/* Ana menu ve duraklama ekraninin ortak stili.
   Oyun ici HUD'dan ayri bir dosya: HUD stil sayfasi zaten buyuk ve bu iki
   ekran oyun sahnesinden bagimsiz olarak da (ana menu sahnesi) yukleniyor. */

:root {
  --bg-panel: rgba(12, 12, 14, 0.94);
  --bg-veil: rgba(3, 4, 6, 0.45);
  --border-soft: rgba(255, 255, 255, 0.10);
  --border-strong: rgba(255, 255, 255, 0.22);
  --accent: rgb(217, 164, 65);
  --accent-dim: rgba(217, 164, 65, 0.35);
  --text: rgb(232, 230, 224);
  --text-dim: rgb(150, 148, 142);
}

.shell-root {
  flex-grow: 1;
}

/* ---------- Perde ---------- */

.shell-veil {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: var(--bg-veil);
  align-items: center;
  justify-content: center;
  display: none;
}

.shell-veil--open {
  display: flex;
}

/* Ana menude perde her zaman acik; oyun ici duraklamada sinifla aciliyor. */
.shell-veil--always {
  display: flex;
}

/* ---------- Baslik ---------- */

.shell-title {
  text-shadow: 0 3px 12px rgba(0, 0, 0, 0.95);
  font-size: 64px;
  -unity-font-style: bold;
  color: var(--text);
  letter-spacing: 12px;
  margin-bottom: 2px;
  -unity-text-align: middle-center;
}

.shell-subtitle {
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
  font-size: 13px;
  color: var(--accent);
  letter-spacing: 4px;
  margin-bottom: 34px;
  -unity-text-align: middle-center;
}

.shell-heading {
  font-size: 22px;
  -unity-font-style: bold;
  color: var(--text);
  letter-spacing: 4px;
  margin-bottom: 18px;
  -unity-text-align: middle-center;
}

/* ---------- Dugmeler ---------- */

.shell-buttons {
  width: 320px;
}

.shell-button {
  /* Varsayilan calisma zamani temasi dugmeye bir arka plan resmi veriyor;
     kaldirmazsak kendi rengimiz onun gri dokusunun uzerine biniyor. */
  background-image: none;
  height: 46px;
  margin: 4px 0;
  background-color: rgba(9, 10, 13, 0.78);
  border-width: 1px;
  border-color: var(--border-soft);
  border-radius: 0;
  color: var(--text);
  font-size: 15px;
  letter-spacing: 2px;
  -unity-font-style: bold;
}

.shell-button:hover {
  background-color: rgba(217, 164, 65, 0.22);
  border-color: var(--accent);
  color: var(--accent);
}

.shell-button:disabled {
  color: rgba(150, 148, 142, 0.45);
  border-color: rgba(255, 255, 255, 0.05);
}

.shell-button--primary {
  background-color: rgba(83, 62, 22, 0.90);
  border-color: var(--accent-dim);
  color: var(--accent);
}

.shell-button--danger:hover {
  background-color: rgba(206, 110, 102, 0.18);
  border-color: rgb(206, 110, 102);
  color: rgb(206, 110, 102);
}

/* ---------- Ayar paneli ---------- */

.shell-page {
  width: 520px;
  background-color: var(--bg-panel);
  border-width: 1px;
  border-color: var(--border-strong);
  padding: 26px 30px;
  display: none;
}

.shell-page--open {
  display: flex;
}

.settings-row {
  flex-direction: row;
  align-items: center;
  height: 34px;
  margin-bottom: 6px;
}

.settings-label {
  width: 150px;
  color: var(--text-dim);
  font-size: 12px;
  letter-spacing: 1px;
}

.settings-slider {
  flex-grow: 1;
  margin: 0 10px;
}

.settings-toggle {
  flex-grow: 1;
  margin: 0 10px;
}

.settings-dropdown {
  flex-grow: 1;
  margin: 0 10px;
}

.settings-value {
  width: 62px;
  color: var(--accent);
  font-size: 12px;
  -unity-text-align: middle-right;
}

.settings-hint {
  color: var(--text-dim);
  font-size: 10px;
  margin-top: 12px;
  white-space: normal;
}

/* ---------- Alt bilgi ---------- */

.shell-footer {
  position: absolute;
  bottom: 14px;
  left: 0;
  right: 0;
  color: var(--text-dim);
  font-size: 10px;
  letter-spacing: 1px;
  -unity-text-align: middle-center;
}

.shell-status {
  color: var(--accent);
  font-size: 11px;
  margin-top: 12px;
  -unity-text-align: middle-center;
  min-height: 14px;
}

/* ---------- Unity'nin hazir denetimlerini karanlik temaya cekmek ----------
   Slider, acilir liste ve onay kutusu varsayilan olarak Editor'un acik gri
   temasiyla geliyor. Kendi denetimlerimizi yazmak yerine hazir olanlari
   giydirmek hem daha az kod hem klavye/erisilebilirlik davranisini koruyor. */

.settings-slider .unity-base-slider__tracker {
  background-color: rgba(255, 255, 255, 0.13);
  border-width: 0;
  height: 3px;
  margin-top: 6px;
}

.settings-slider .unity-base-slider__dragger {
  background-color: var(--accent);
  border-width: 0;
  border-radius: 0;
  width: 6px;
  height: 18px;
  margin-top: -2px;
}

.settings-slider:hover .unity-base-slider__dragger {
  background-color: rgb(240, 196, 110);
}

.settings-toggle .unity-toggle__checkmark {
  background-color: rgba(0, 0, 0, 0.55);
  border-width: 1px;
  border-color: var(--border-strong);
  border-radius: 0;
  width: 17px;
  height: 17px;
  -unity-background-image-tint-color: var(--accent);
}

.settings-dropdown .unity-base-popup-field__input {
  background-color: rgba(0, 0, 0, 0.55);
  background-image: none;
  border-width: 1px;
  border-color: var(--border-soft);
  border-radius: 0;
  height: 26px;
}

.settings-dropdown .unity-base-popup-field__text {
  color: var(--text);
  font-size: 12px;
  -unity-text-align: middle-left;
  padding-left: 6px;
}

.settings-dropdown .unity-base-popup-field__arrow {
  -unity-background-image-tint-color: var(--accent);
}

/* Ayar sayfasindaki tek "geri" dugmesi tum genisligi kaplayinca ana menudeki
   dugme yiginiyla ayni dile ait gorunmuyordu; ayni genislige cekiyoruz. */
.shell-page .shell-buttons {
  width: 320px;
  align-self: center;
}

/* Acilir listenin metni varsayilan temanin koyu rengiyle geliyor ve karanlik
   zeminde okunmuyor; hem alani hem icindeki Label'i hedefliyoruz cunku
   surumden surume hangisinin rengi tasidigi degisebiliyor. */
.settings-dropdown .unity-base-popup-field__input,
.settings-dropdown .unity-base-popup-field__text,
.settings-dropdown Label {
  color: var(--text);
}

.settings-toggle .unity-toggle__checkmark {
  -unity-background-image-tint-color: rgb(217, 164, 65);
}
