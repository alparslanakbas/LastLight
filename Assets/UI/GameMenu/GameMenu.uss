:root {
  --bg-panel: rgba(12, 12, 14, 0.94);
  --bg-overlay: rgba(4, 5, 7, 0.72);
  --bg-slot: rgba(255, 255, 255, 0.05);
  --bg-slot-hover: rgba(255, 255, 255, 0.12);
  --border-soft: rgba(255, 255, 255, 0.10);
  --border-strong: rgba(255, 255, 255, 0.22);
  --accent: rgb(217, 164, 65);
  --accent-dim: rgba(217, 164, 65, 0.35);
  --text: rgb(232, 230, 224);
  --text-dim: rgb(150, 148, 142);
  --ok: rgb(126, 186, 122);
  --bad: rgb(206, 110, 102);
  --space: 8px;
}

.root {
  flex-grow: 1;
}

/* ---------- Tab ile acilan ekran ---------- */

.menu-overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: var(--bg-overlay);
  padding: 28px 40px 120px 40px;
  display: none;
}

.menu-overlay--open {
  display: flex;
}

.tab-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--space);
}

.tab-button {
  padding: 8px 22px;
  margin-right: 4px;
  background-color: rgba(20, 20, 24, 0.9);
  border-width: 1px;
  border-color: var(--border-soft);
  border-bottom-width: 2px;
  border-bottom-color: transparent;
  color: var(--text-dim);
  font-size: 13px;
  -unity-font-style: bold;
  transition-duration: 0.12s;
}

.tab-button:hover {
  background-color: rgba(34, 34, 40, 0.95);
  color: var(--text);
}

.tab-button--active {
  color: var(--accent);
  border-bottom-color: var(--accent);
  background-color: rgba(30, 28, 24, 0.95);
}

.tab-spacer {
  flex-grow: 1;
}

.tab-hint {
  color: var(--text-dim);
  font-size: 11px;
}

.menu-body {
  flex-direction: row;
  flex-grow: 1;
}

.panel {
  background-color: var(--bg-panel);
  border-width: 1px;
  border-color: var(--border-soft);
  padding: 12px;
}

.panel--left {
  flex-grow: 1;
  margin-right: var(--space);
}

.panel--right {
  width: 560px;
}

.page {
  flex-grow: 1;
}

.page--hidden {
  display: none;
}

.panel-header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.panel-title {
  color: var(--accent);
  font-size: 13px;
  -unity-font-style: bold;
  margin-bottom: 6px;
}

.panel-badge {
  color: var(--text-dim);
  font-size: 12px;
}

.panel-note {
  color: var(--text-dim);
  font-size: 11px;
  margin-bottom: 8px;
  white-space: normal;
}

.scroll {
  flex-grow: 1;
}

/* ---------- Tarif ve beceri satirlari ---------- */

.row {
  flex-direction: row;
  align-items: center;
  padding: 8px 10px;
  margin-bottom: 4px;
  background-color: rgba(255, 255, 255, 0.04);
  border-left-width: 3px;
  border-left-color: transparent;
  transition-duration: 0.12s;
}

.row:hover {
  background-color: rgba(255, 255, 255, 0.09);
}

.row--ready {
  border-left-color: var(--ok);
}

.row--locked {
  border-left-color: rgba(255, 255, 255, 0.12);
}

.row--owned {
  border-left-color: var(--accent);
  background-color: rgba(217, 164, 65, 0.10);
}

.row-body {
  flex-grow: 1;
}

.row-title {
  color: var(--text);
  font-size: 13px;
}

.row-sub {
  color: var(--text-dim);
  font-size: 11px;
  margin-top: 2px;
  white-space: normal;
}

.row-sub--ok {
  color: var(--ok);
}

.row-sub--bad {
  color: var(--bad);
}

.row-action {
  padding: 5px 14px;
  background-color: rgba(217, 164, 65, 0.16);
  border-width: 1px;
  border-color: var(--accent-dim);
  color: var(--accent);
  font-size: 12px;
  transition-duration: 0.12s;
}

.row-action:hover {
  background-color: rgba(217, 164, 65, 0.30);
}

.row-tag {
  color: var(--text-dim);
  font-size: 11px;
  padding: 5px 8px;
}

.branch-title {
  color: rgb(120, 160, 200);
  font-size: 11px;
  -unity-font-style: bold;
  margin-top: 10px;
  margin-bottom: 4px;
}

/* ---------- Envanter ---------- */

.grid {
  flex-direction: row;
  flex-wrap: wrap;
}

.slot {
  width: 62px;
  height: 62px;
  margin-right: 4px;
  margin-bottom: 4px;
  background-color: var(--bg-slot);
  border-width: 1px;
  border-color: var(--border-soft);
  justify-content: flex-end;
  transition-duration: 0.12s;
}

.slot:hover {
  background-color: var(--bg-slot-hover);
  border-color: var(--border-strong);
}

.slot--selected {
  border-color: var(--accent);
  border-width: 2px;
}

.slot-fill {
  position: absolute;
  left: 4px;
  top: 4px;
  right: 4px;
  bottom: 4px;
}

.slot-name {
  color: rgba(255, 255, 255, 0.92);
  font-size: 9px;
  padding-left: 3px;
  padding-right: 3px;
}

.slot-count {
  color: rgb(255, 255, 255);
  font-size: 12px;
  -unity-font-style: bold;
  -unity-text-align: lower-right;
  padding-right: 4px;
  padding-bottom: 2px;
}

/* ---------- Surekli gorunen HUD ---------- */

.hud {
  position: absolute;
  right: 16px;
  top: 14px;
}

/* Menu acikken saat kutusu sekme ipucuyla ust uste biniyordu. */
.hud--hidden {
  display: none;
}

.clock-box {
  background-color: rgba(0, 0, 0, 0.55);
  padding: 8px 14px;
  border-width: 1px;
  border-color: var(--border-soft);
}

.clock-text {
  color: var(--text);
  font-size: 13px;
}

.clock-phase {
  font-size: 11px;
  margin-top: 2px;
}

.clock-phase--day {
  color: var(--ok);
}

.clock-phase--night {
  color: var(--bad);
}

/* ---------- Hotbar ---------- */

.hotbar {
  position: absolute;
  bottom: 18px;
  left: 0;
  right: 0;
  flex-direction: row;
  justify-content: center;
}

.hotbar-slot {
  width: 58px;
  height: 58px;
  margin-left: 3px;
  margin-right: 3px;
  background-color: rgba(0, 0, 0, 0.55);
  border-width: 1px;
  border-color: var(--border-soft);
  justify-content: flex-end;
}

.hotbar-slot--selected {
  border-color: var(--accent);
  border-width: 2px;
  background-color: rgba(0, 0, 0, 0.75);
}

.hotbar-index {
  position: absolute;
  left: 4px;
  top: 2px;
  color: var(--text-dim);
  font-size: 10px;
}
